      <column caption='Installs Numeric' datatype='integer' name='[Calculation_1695042353812885504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(REPLACE(REPLACE([Installs], &quot;,&quot;, &quot;&quot;), &quot;+&quot;, &quot;&quot;))' />
      </column>
      <column caption='Size Numeric MB' datatype='real' name='[Calculation_1695042353813934082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([Size], &quot;M&quot;) THEN&#13;&#10;    FLOAT(REPLACE([Size], &quot;M&quot;, &quot;&quot;))&#13;&#10;ELSEIF CONTAINS([Size], &quot;k&quot;) THEN&#13;&#10;    FLOAT(REPLACE([Size], &quot;k&quot;, &quot;&quot;)) / 1024&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='Category Clean' datatype='string' name='[Calculation_1695042353814528003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(TRIM([Category]))' />
      </column>
      <column caption='Generes clean' datatype='string' name='[Calculation_1695042353814630404]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM([Genres])' />
      </column>
      <column caption='Type clean' datatype='string' name='[Calculation_1695042353814773765]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM([Type])' />
      </column>
      <column caption='Price numeric' datatype='real' name='[Calculation_1695042354132987913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;))' />
      </column>
      <column aggregation='None' caption='Installs Numeric (bin)' datatype='integer' name='[Installs Numeric (bin)]' role='dimension' type='ordinal'>
